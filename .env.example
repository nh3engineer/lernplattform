# Vorlage fuer die E-Mail-Konfiguration der Lernplattform.
# Kopiere diese Datei nach ".env" und trage deine Werte ein,
# ODER setze die Variablen direkt als Umgebungsvariablen.
#
# WICHTIG: Fuer Gmail wird ein App-Passwort benoetigt (NICHT das normale
# Google-Passwort). App-Passwort erstellen:
#   Google-Konto -> Sicherheit -> Bestaetigung in zwei Schritten aktivieren
#   -> App-Passwoerter -> neues Passwort fuer "Mail" erzeugen.

LP_SMTP_HOST=smtp.gmail.com
LP_SMTP_PORT=587
LP_SMTP_USE_TLS=true

# Absender-Konto (hier das Office-Postfach):
LP_SMTP_USER=hechtl.office@gmail.com
LP_SMTP_PASS=DEIN_16STELLIGES_APP_PASSWORT
LP_MAIL_FROM=hechtl.office@gmail.com

# Lehrkraft-Adresse, die immer eine Kopie jeder Auswertung erhaelt:
LP_INSTRUCTOR_EMAIL=hechtl.office@gmail.com

# Optional:
# LP_PORT=5000
# LP_FRAGEN_PRO_PRUEFUNG=0   # 0 = alle Fragen des Themas
