{
  "faecher": {
    "mathematik": {
      "name": "Mathematik",
      "stufen": {
        "1": {
          "name": "HTL 1. Klasse",
          "themen": {
            "termumformungen": {
              "name": "Termumformungen & Grundrechenarten",
              "fragen": [
                {"id": "m1-term-1", "typ": "mc", "frage": "Vereinfache: 3a + 5a - 2a", "optionen": ["6a", "10a", "a", "8a"], "loesung": 0, "erklaerung": "3 + 5 - 2 = 6, also 6a."},
                {"id": "m1-term-2", "typ": "mc", "frage": "Multipliziere aus: 2(x + 4)", "optionen": ["2x + 4", "2x + 8", "x + 8", "2x + 6"], "loesung": 1, "erklaerung": "2·x + 2·4 = 2x + 8."},
                {"id": "m1-term-3", "typ": "num", "frage": "Berechne den Wert des Terms 4x - 3 für x = 5.", "loesung": 17, "toleranz": 0.001, "einheit": "", "erklaerung": "4·5 - 3 = 20 - 3 = 17."},
                {"id": "m1-term-4", "typ": "mc", "frage": "Binomische Formel: (a + b)² =", "optionen": ["a² + b²", "a² + ab + b²", "a² + 2ab + b²", "a² - 2ab + b²"], "loesung": 2, "erklaerung": "Erste binomische Formel: a² + 2ab + b²."},
                {"id": "m1-term-5", "typ": "num", "frage": "Berechne: (-3)² + 2·(-4)", "loesung": 1, "toleranz": 0.001, "einheit": "", "erklaerung": "9 + (-8) = 1."}
              ]
            },
            "lineare-gleichungen": {
              "name": "Lineare Gleichungen",
              "fragen": [
                {"id": "m1-lin-1", "typ": "num", "frage": "Löse nach x: 2x + 6 = 14", "loesung": 4, "toleranz": 0.001, "einheit": "", "erklaerung": "2x = 8, x = 4."},
                {"id": "m1-lin-2", "typ": "num", "frage": "Löse nach x: 5x - 7 = 3x + 5", "loesung": 6, "toleranz": 0.001, "einheit": "", "erklaerung": "2x = 12, x = 6."},
                {"id": "m1-lin-3", "typ": "mc", "frage": "Welche Umformung ist bei Gleichungen erlaubt?", "optionen": ["Beide Seiten mit 0 multiplizieren", "Auf beiden Seiten dieselbe Zahl addieren", "Nur eine Seite verändern", "Durch eine Variable dividieren, die 0 sein kann"], "loesung": 1, "erklaerung": "Äquivalenzumformungen müssen auf beiden Seiten gleich erfolgen."},
                {"id": "m1-lin-4", "typ": "num", "frage": "Löse nach x: (x/3) = 4", "loesung": 12, "toleranz": 0.001, "einheit": "", "erklaerung": "x = 4·3 = 12."}
              ]
            },
            "prozentrechnung": {
              "name": "Prozent- & Schlussrechnung",
              "fragen": [
                {"id": "m1-proz-1", "typ": "num", "frage": "Wie viel sind 15 % von 240?", "loesung": 36, "toleranz": 0.01, "einheit": "", "erklaerung": "240·0,15 = 36."},
                {"id": "m1-proz-2", "typ": "num", "frage": "Ein Preis steigt von 80 € auf 100 €. Um wie viel Prozent?", "loesung": 25, "toleranz": 0.1, "einheit": "%", "erklaerung": "20/80 = 0,25 = 25 %."},
                {"id": "m1-proz-3", "typ": "num", "frage": "Von welcher Zahl sind 30 gleich 12 %?", "loesung": 250, "toleranz": 0.1, "einheit": "", "erklaerung": "30/0,12 = 250."}
              ]
            }
          }
        },
        "2": {
          "name": "HTL 2. Klasse",
          "themen": {
            "quadratische-gleichungen": {
              "name": "Quadratische Gleichungen",
              "fragen": [
                {"id": "m2-quad-1", "typ": "mc", "frage": "Die Lösungsformel für ax² + bx + c = 0 lautet x =", "optionen": ["(-b ± √(b²-4ac)) / (2a)", "(-b ± √(b²+4ac)) / (2a)", "(b ± √(b²-4ac)) / a", "(-b ± √(4ac-b²)) / (2a)"], "loesung": 0, "erklaerung": "Große Lösungsformel (Mitternachtsformel)."},
                {"id": "m2-quad-2", "typ": "num", "frage": "Eine Lösung von x² - 5x + 6 = 0 ist x = 2. Wie lautet die zweite Lösung?", "loesung": 3, "toleranz": 0.001, "einheit": "", "erklaerung": "Nach Vieta: x1·x2 = 6, 2·x2 = 6, x2 = 3."},
                {"id": "m2-quad-3", "typ": "num", "frage": "Berechne die Diskriminante von x² - 4x + 4 = 0.", "loesung": 0, "toleranz": 0.001, "einheit": "", "erklaerung": "D = b²-4ac = 16 - 16 = 0 (Doppellösung)."},
                {"id": "m2-quad-4", "typ": "mc", "frage": "Was bedeutet eine negative Diskriminante (D < 0)?", "optionen": ["Zwei reelle Lösungen", "Eine reelle Lösung", "Keine reelle Lösung", "Unendlich viele Lösungen"], "loesung": 2, "erklaerung": "Bei D < 0 gibt es keine reellen, sondern konjugiert komplexe Lösungen."}
              ]
            },
            "trigonometrie": {
              "name": "Trigonometrie im rechtwinkligen Dreieck",
              "fragen": [
                {"id": "m2-trig-1", "typ": "mc", "frage": "Im rechtwinkligen Dreieck gilt sin(α) =", "optionen": ["Ankathete / Hypotenuse", "Gegenkathete / Hypotenuse", "Gegenkathete / Ankathete", "Hypotenuse / Gegenkathete"], "loesung": 1, "erklaerung": "Sinus = Gegenkathete / Hypotenuse."},
                {"id": "m2-trig-2", "typ": "num", "frage": "Berechne sin(30°). (Dezimalwert)", "loesung": 0.5, "toleranz": 0.01, "einheit": "", "erklaerung": "sin(30°) = 0,5."},
                {"id": "m2-trig-3", "typ": "num", "frage": "Ein rechtwinkliges Dreieck hat Katheten 3 und 4. Wie lang ist die Hypotenuse?", "loesung": 5, "toleranz": 0.01, "einheit": "", "erklaerung": "√(3²+4²) = √25 = 5 (Satz des Pythagoras)."},
                {"id": "m2-trig-4", "typ": "mc", "frage": "tan(α) ist definiert als", "optionen": ["sin(α)·cos(α)", "sin(α) / cos(α)", "cos(α) / sin(α)", "1 / sin(α)"], "loesung": 1, "erklaerung": "tan = sin/cos = Gegenkathete/Ankathete."}
              ]
            },
            "funktionen": {
              "name": "Lineare & quadratische Funktionen",
              "fragen": [
                {"id": "m2-fkt-1", "typ": "mc", "frage": "Die Steigung der Geraden y = 3x + 2 beträgt", "optionen": ["2", "3", "3x", "5"], "loesung": 1, "erklaerung": "k = 3 (Koeffizient von x)."},
                {"id": "m2-fkt-2", "typ": "num", "frage": "Wo schneidet y = 2x - 6 die x-Achse? (x-Wert)", "loesung": 3, "toleranz": 0.001, "einheit": "", "erklaerung": "2x - 6 = 0, x = 3."},
                {"id": "m2-fkt-3", "typ": "mc", "frage": "Der Graph von y = x² ist eine", "optionen": ["Gerade", "Parabel", "Hyperbel", "Kreis"], "loesung": 1, "erklaerung": "Quadratische Funktion → nach oben geöffnete Parabel."}
              ]
            }
          }
        },
        "3": {
          "name": "HTL 3. Klasse",
          "themen": {
            "differentialrechnung": {
              "name": "Differentialrechnung",
              "fragen": [
                {"id": "m3-diff-1", "typ": "mc", "frage": "Die Ableitung von f(x) = x³ ist", "optionen": ["3x²", "x²", "3x", "x⁴/4"], "loesung": 0, "erklaerung": "Potenzregel: f'(x) = 3x²."},
                {"id": "m3-diff-2", "typ": "num", "frage": "Berechne f'(2) für f(x) = x².", "loesung": 4, "toleranz": 0.001, "einheit": "", "erklaerung": "f'(x) = 2x, f'(2) = 4."},
                {"id": "m3-diff-3", "typ": "mc", "frage": "Die Ableitung von f(x) = sin(x) ist", "optionen": ["-sin(x)", "cos(x)", "-cos(x)", "tan(x)"], "loesung": 1, "erklaerung": "f'(x) = cos(x)."},
                {"id": "m3-diff-4", "typ": "mc", "frage": "An einem lokalen Extremum einer differenzierbaren Funktion gilt", "optionen": ["f(x) = 0", "f'(x) = 0", "f''(x) = 0", "f'(x) = 1"], "loesung": 1, "erklaerung": "Notwendige Bedingung: erste Ableitung null."},
                {"id": "m3-diff-5", "typ": "num", "frage": "Für f(x) = 3x² + 2x: berechne f'(1).", "loesung": 8, "toleranz": 0.001, "einheit": "", "erklaerung": "f'(x) = 6x + 2, f'(1) = 8."}
              ]
            },
            "exp-log": {
              "name": "Exponential- & Logarithmusfunktionen",
              "fragen": [
                {"id": "m3-exp-1", "typ": "num", "frage": "Berechne log₁₀(1000).", "loesung": 3, "toleranz": 0.001, "einheit": "", "erklaerung": "10³ = 1000, also log = 3."},
                {"id": "m3-exp-2", "typ": "mc", "frage": "Die Ableitung von f(x) = eˣ ist", "optionen": ["x·eˣ⁻¹", "eˣ", "1/x", "ln(x)"], "loesung": 1, "erklaerung": "e-Funktion ist ihre eigene Ableitung."},
                {"id": "m3-exp-3", "typ": "num", "frage": "Berechne ln(1).", "loesung": 0, "toleranz": 0.001, "einheit": "", "erklaerung": "e⁰ = 1, also ln(1) = 0."},
                {"id": "m3-exp-4", "typ": "mc", "frage": "Welches Gesetz gilt? log(a·b) =", "optionen": ["log(a)·log(b)", "log(a) + log(b)", "log(a) - log(b)", "log(a)/log(b)"], "loesung": 1, "erklaerung": "Logarithmus eines Produkts = Summe der Logarithmen."}
              ]
            }
          }
        },
        "4": {
          "name": "HTL 4. Klasse",
          "themen": {
            "integralrechnung": {
              "name": "Integralrechnung",
              "fragen": [
                {"id": "m4-int-1", "typ": "mc", "frage": "Die Stammfunktion von f(x) = 2x ist", "optionen": ["2", "x² + C", "2x² + C", "x + C"], "loesung": 1, "erklaerung": "∫2x dx = x² + C."},
                {"id": "m4-int-2", "typ": "num", "frage": "Berechne das bestimmte Integral ∫₀² 2x dx.", "loesung": 4, "toleranz": 0.001, "einheit": "", "erklaerung": "[x²]₀² = 4 - 0 = 4."},
                {"id": "m4-int-3", "typ": "mc", "frage": "∫ eˣ dx =", "optionen": ["eˣ + C", "x·eˣ + C", "eˣ⁺¹ + C", "ln(x) + C"], "loesung": 0, "erklaerung": "Stammfunktion von eˣ ist eˣ + C."},
                {"id": "m4-int-4", "typ": "num", "frage": "Berechne ∫₁³ 1 dx.", "loesung": 2, "toleranz": 0.001, "einheit": "", "erklaerung": "[x]₁³ = 3 - 1 = 2."}
              ]
            },
            "komplexe-zahlen": {
              "name": "Komplexe Zahlen",
              "fragen": [
                {"id": "m4-kplx-1", "typ": "mc", "frage": "Die imaginäre Einheit i erfüllt", "optionen": ["i² = 1", "i² = -1", "i = -1", "i² = 0"], "loesung": 1, "erklaerung": "Definition: i² = -1."},
                {"id": "m4-kplx-2", "typ": "mc", "frage": "Der Betrag von z = 3 + 4i ist", "optionen": ["7", "5", "12", "25"], "loesung": 1, "erklaerung": "|z| = √(3²+4²) = 5."},
                {"id": "m4-kplx-3", "typ": "mc", "frage": "Die konjugiert komplexe Zahl zu z = 2 - 5i ist", "optionen": ["-2 + 5i", "2 + 5i", "-2 - 5i", "5 - 2i"], "loesung": 1, "erklaerung": "Vorzeichen des Imaginärteils umkehren: 2 + 5i."}
              ]
            }
          }
        },
        "5": {
          "name": "HTL 5. Klasse",
          "themen": {
            "wahrscheinlichkeit": {
              "name": "Wahrscheinlichkeit & Statistik",
              "fragen": [
                {"id": "m5-wsk-1", "typ": "num", "frage": "Wie groß ist die Wahrscheinlichkeit, mit einem fairen Würfel eine 6 zu werfen? (Dezimal, gerundet auf 3 Stellen)", "loesung": 0.167, "toleranz": 0.002, "einheit": "", "erklaerung": "1/6 ≈ 0,167."},
                {"id": "m5-wsk-2", "typ": "num", "frage": "Berechne den Mittelwert von 4, 8, 10, 6, 2.", "loesung": 6, "toleranz": 0.01, "einheit": "", "erklaerung": "(4+8+10+6+2)/5 = 30/5 = 6."},
                {"id": "m5-wsk-3", "typ": "mc", "frage": "Die Summe aller Wahrscheinlichkeiten eines Zufallsexperiments ist", "optionen": ["0", "0,5", "1", "100"], "loesung": 2, "erklaerung": "Normierung: Gesamtwahrscheinlichkeit = 1."},
                {"id": "m5-wsk-4", "typ": "num", "frage": "Zwei faire Münzen: Wahrscheinlichkeit für zweimal Kopf? (Dezimal)", "loesung": 0.25, "toleranz": 0.001, "einheit": "", "erklaerung": "0,5·0,5 = 0,25."}
              ]
            },
            "differentialgleichungen": {
              "name": "Differentialgleichungen (Einführung)",
              "fragen": [
                {"id": "m5-dgl-1", "typ": "mc", "frage": "Die Lösung von y' = y ist", "optionen": ["y = x²", "y = C·eˣ", "y = sin(x)", "y = ln(x)"], "loesung": 1, "erklaerung": "Exponentielles Wachstum: y = C·eˣ."},
                {"id": "m5-dgl-2", "typ": "mc", "frage": "Eine Differentialgleichung 1. Ordnung enthält höchstens", "optionen": ["die Funktion selbst", "die erste Ableitung", "die zweite Ableitung", "die dritte Ableitung"], "loesung": 1, "erklaerung": "Ordnung = höchste vorkommende Ableitung, hier y'."}
              ]
            }
          }
        }
      }
    },
