                {"id": "p1-kraft-4", "typ": "mc", "frage": "Das newtonsche Grundgesetz lautet", "optionen": ["F = m/a", "F = m·a", "F = a/m", "F = m·v"], "loesung": 1, "erklaerung": "Kraft = Masse · Beschleunigung."}
