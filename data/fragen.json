                {"id": "p1-kin-3", "typ": "num", "frage": "Wandle 72 km/h in m/s um.", "loesung": 20, "toleranz": 0.1, "einheit": "m/s", "erklaerung": "72 / 3,6 = 20 m/s."},
                {"id": "p1-kin-4", "typ": "num", "frage": "Mit 10 m/s: welche Strecke in 5 s? (gleichförmig)", "loesung": 50, "toleranz": 0.1, "einheit": "m", "erklaerung": "s = v·t = 10·5 = 50 m."}
